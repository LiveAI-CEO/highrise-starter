{
  "name": "@liveai/golden-highrise-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.16.0 <23" },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "security:secrets": "npx secretlint \"**/*\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@gohighlevel/ghl-icons": "latest",
    "@pinia/nuxt": "0.11.2",
    "@platform-ui/highrise": "latest",
    "@platform-ui/nuxt": "latest",
    "@vueuse/core": "13.5.0",
    "@vueuse/nuxt": "13.5.0",
    "joi": "17.13.3",
    "nuxt": "3.17.7",
    "pinia": "3.0.3",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@ghl-plugins/tailwind-prefix-wrapper": "latest",
    "@nuxt/eslint": "1.5.2",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@playwright/test": "1.54.1",
    "@secretlint/secretlint-rule-preset-recommend": "9.3.4",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.31.0",
    "happy-dom": "18.0.1",
    "postcss": "8.5.6",
    "secretlint": "9.3.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "vue": "3.5.20",
    "css-render": "^0.15.14",
    "@css-render/vue3-ssr": "^0.15.14"
  }
}
